{#
  Inline-SVG icon set (no dependencies). Usage:
    {% from "partials/icons.njk" import icon %}
    {{ icon("anchor") }}            -> default class "ico"
    {{ icon("anchor", "ico ico--lg") }}
  All icons are 24x24, stroke = currentColor, so they inherit text color.
#}
{% macro icon(name, cls="ico") %}
<svg class="{{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{%- if name == "check" -%}<polyline points="20 6 9 17 4 12"/>
{%- elif name == "waves" or name == "swim" -%}<path d="M2 8.5c2 0 2 1.6 4 1.6s2-1.6 4-1.6 2 1.6 4 1.6 2-1.6 4-1.6 2 1.6 4 1.6"/><path d="M2 14c2 0 2 1.6 4 1.6S8 14 10 14s2 1.6 4 1.6S16 14 18 14s2 1.6 4 1.6"/>
{%- elif name == "bird" or name == "birds" -%}<path d="M3 13 Q7 8 11 13 Q15 8 19 13"/><path d="M11 13v4"/>
{%- elif name == "fish" or name == "marine" -%}<path d="M5 12c2-4 7-6 12-4 2 .8 4 2 5 4-1 2-3 3.2-5 4-5 2-10 0-12-4z"/><path d="M5 12 1 9v6z"/><circle cx="17" cy="11" r=".7" fill="currentColor"/>
{%- elif name == "users" or name == "guide" -%}<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
{%- elif name == "vest" or name == "lifebuoy" -%}<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/><line x1="4.93" y1="4.93" x2="9.17" y2="9.17"/><line x1="14.83" y1="14.83" x2="19.07" y2="19.07"/><line x1="14.83" y1="9.17" x2="19.07" y2="4.93"/><line x1="4.93" y1="19.07" x2="9.17" y2="14.83"/>
{%- elif name == "wetsuit" or name == "cold" -%}<line x1="12" y1="2" x2="12" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/><line x1="5" y1="5" x2="19" y2="19"/><line x1="19" y1="5" x2="5" y2="19"/>
{%- elif name == "drinks" or name == "coffee" -%}<path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4z"/><line x1="6" y1="2" x2="6" y2="4"/><line x1="10" y1="2" x2="10" y2="4"/><line x1="14" y1="2" x2="14" y2="4"/>
{%- elif name == "pill" or name == "seasickness" -%}<path d="M10.5 3.5a5 5 0 0 1 7 7l-7 7a5 5 0 0 1-7-7z"/><line x1="7" y1="7" x2="17" y2="17"/>
{%- elif name == "anchor" or name == "pier" -%}<circle cx="12" cy="5" r="3"/><line x1="12" y1="22" x2="12" y2="8"/><path d="M5 12H2a10 10 0 0 0 20 0h-3"/>
{%- elif name == "boat" or name == "yacht" -%}<path d="M3 14h18l-2 5H5z"/><path d="M12 14V4l6 4-6 2"/>
{%- elif name == "shield" or name == "insurance" -%}<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
{%- elif name == "droplet" or name == "water" -%}<path d="M12 2.7l5.66 5.66a8 8 0 1 1-11.31 0z"/>
{%- elif name == "ban" or name == "no-plastic" -%}<circle cx="12" cy="12" r="9"/><line x1="5.6" y1="5.6" x2="18.4" y2="18.4"/>
{%- elif name == "recycle" or name == "reciclables" or name == "zero-waste" -%}<polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
{%- elif name == "leaf" or name == "organicos" -%}<path d="M5 21c0-9 6-15 15-16 1 9-6 16-15 16z"/><path d="M5 21C9 17 13 13 17 11"/>
{%- elif name == "trash" or name == "no-aprovechables" -%}<polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/>
{%- elif name == "paper" or name == "papel" or name == "file" or name == "reservas" -%}<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="16" y2="17"/>
{%- elif name == "card" or name == "pagos" -%}<rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/>
{%- elif name == "truck" or name == "traslados" -%}<rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
{%- elif name == "calendar" or name == "anulaciones" -%}<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
{%- elif name == "award" or name == "sernanp" -%}<circle cx="12" cy="8" r="6"/><path d="M15.5 12.9 17 22l-5-3-5 3 1.5-9.1"/>
{%- elif name == "info" or name == "awareness" -%}<circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>
{%- elif name == "binoculars" -%}<circle cx="6.5" cy="14" r="3.5"/><circle cx="17.5" cy="14" r="3.5"/><path d="M9.5 12l1.5-6h2l1.5 6"/><line x1="10" y1="8" x2="14" y2="8"/>
{%- elif name == "ticket" -%}<path d="M3 9V7a1 1 0 0 1 1-1h16a1 1 0 0 1 1 1v2a2 2 0 0 0 0 4v2a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-2a2 2 0 0 0 0-4z"/><line x1="13" y1="7" x2="13" y2="17" stroke-dasharray="2 2"/>
{%- elif name == "clock" -%}<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
{%- elif name == "camera" -%}<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M8 7l1.5-3h5L16 7"/><circle cx="12" cy="14" r="3.5"/>
{%- elif name == "cloud" or name == "weather" -%}<path d="M17.5 19a4.5 4.5 0 0 0 .5-8.97A6 6 0 0 0 6 9.5 4.5 4.5 0 0 0 6.5 19z"/>
{%- elif name == "pin" or name == "map" -%}<path d="M12 21s7-5.5 7-11a7 7 0 0 0-14 0c0 5.5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/>
{%- else -%}<circle cx="12" cy="12" r="9"/>
{%- endif -%}
</svg>
{% endmacro %}
