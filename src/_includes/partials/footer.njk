{% set t = i18n[lang] %}
{% set p = "/en" if lang == "en" else "" %}
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="brand" style="margin-bottom:var(--space-3)">
          <img class="brand__img brand__img--footer" src="/assets/img/logo_ecocruceros.jpeg" alt="Ecocruceros — Islas Palomino">
        </div>
        <p style="color:var(--text-on-dark-soft)">{{ t.trust.pioneer }}.</p>
      </div>
      <div>
        <h4>{{ t.footer.nav }}</h4>
        <ul>
          <li><a href="{{ p }}/">{{ t.nav.home }}</a></li>
          <li><a href="{{ p }}/nosotros/">{{ t.nav.about }}</a></li>
          <li><a href="{{ p }}/sostenibilidad/">{{ t.nav.sustain }}</a></li>
          <li><a href="{{ p }}/galeria/">{{ t.nav.gallery }}</a></li>
          <li><a href="{{ p }}/blog/">{{ t.nav.blog }}</a></li>
        </ul>
      </div>
      <div>
        <h4>{{ t.footer.tourCol }}</h4>
        <ul>
          <li><a href="{{ p }}/tour/recorrido/">{{ t.nav.route }}</a></li>
          <li><a href="{{ p }}/tour/precios/">{{ t.nav.pricing }}</a></li>
          <li><a href="{{ p }}/tour/seguridad/">{{ t.nav.safety }}</a></li>
          <li><a href="{{ p }}/faq/">{{ t.nav.faq }}</a></li>
        </ul>
      </div>
      <div>
        <h4>{{ t.footer.contactCol }}</h4>
        <ul>
          <li><a data-wa-source="footer" href="{{ t.wa.general | wa }}">{{ site.whatsappDisplay }}</a></li>
          <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
          <li>{{ site.location }}</li>
        </ul>
        <div class="social-row" style="margin-top:var(--space-3)">
          <a href="{{ site.social.facebook }}" aria-label="Facebook" rel="noopener" target="_blank"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 10-11.5 9.9v-7H8v-2.9h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6v1.8h2.8l-.4 2.9h-2.4v7A10 10 0 0022 12z"/></svg></a>
          <a href="{{ site.social.instagram }}" aria-label="Instagram" rel="noopener" target="_blank"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>
          <a href="{{ site.social.youtube }}" aria-label="YouTube" rel="noopener" target="_blank"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M23 12s0-3.2-.4-4.7a2.5 2.5 0 00-1.8-1.8C19.3 5 12 5 12 5s-7.3 0-8.8.5A2.5 2.5 0 001.4 7.3C1 8.8 1 12 1 12s0 3.2.4 4.7a2.5 2.5 0 001.8 1.8C4.7 19 12 19 12 19s7.3 0 8.8-.5a2.5 2.5 0 001.8-1.8C23 15.2 23 12 23 12zm-13 3V9l5 3z"/></svg></a>
          {% if site.social.tiktok %}<a href="{{ site.social.tiktok }}" aria-label="TikTok" rel="noopener" target="_blank"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M16.6 3c.4 2.1 1.8 3.7 3.9 4v3c-1.5 0-2.9-.5-3.9-1.2v6.7c0 3.4-2.7 6-6.1 6-3.3 0-6-2.6-6-6 0-3.3 2.6-6 5.9-6 .3 0 .7 0 1 .1v3.1a3 3 0 0 0-1-.2 2.9 2.9 0 0 0-2.9 3c0 1.6 1.3 2.9 2.9 2.9s3-1.3 3-2.9V3h3.2z"/></svg></a>{% endif %}
        </div>
      </div>
    </div>

    <div class="footer-certs" aria-label="Certificaciones">
      {% for c in site.certs %}<span>{{ c.name }}</span>{% endfor %}
    </div>

    <div class="footer-bottom">
      <span>© {{ "" | year }} {{ site.name }}. {{ t.footer.rights }}.</span>
      <span>
        <a href="{{ p }}/privacidad/">{{ t.footer.privacy }}</a> ·
        <a href="{{ p }}/terminos/">{{ t.footer.terms }}</a>
      </span>
    </div>

    <div class="footer-credit" style="text-align:center;margin-top:var(--space-2);margin-bottom:calc(-1 * var(--space-3))">
      <small style="color:var(--text-on-dark-soft);font-size:.68rem;opacity:.75">Developed by Locale Americas</small>
    </div>
  </div>
</footer>
