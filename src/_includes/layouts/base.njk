{% set t = i18n[lang] %}<!doctype html>
<html lang="{{ t.htmlLang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}{% if title %} · {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="https://ecocruceros.com{{ page.url }}">
  <link rel="alternate" hreflang="es" href="https://ecocruceros.com{{ page.url | altLang if lang=='en' else page.url }}">
  <link rel="alternate" hreflang="en" href="https://ecocruceros.com{{ page.url if lang=='en' else page.url | altLang }}">
  <link rel="alternate" hreflang="x-default" href="https://ecocruceros.com{{ page.url | altLang if lang=='en' else page.url }}">
  <meta property="og:title" content="{{ title }} · {{ site.name }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="{{ 'es_PE' if lang=='es' else 'en_US' }}">
  <meta property="og:image" content="https://ecocruceros.com{{ ogImage or '/assets/img/hero-swim-lobos.jpg' }}">
  <meta property="og:image:alt" content="{{ title }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }} · {{ site.name }}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="https://ecocruceros.com{{ ogImage or '/assets/img/hero-swim-lobos.jpg' }}">
  <link rel="icon" href="/assets/img/logo_ecocruceros.jpeg">
  <link rel="apple-touch-icon" href="/assets/img/logo_ecocruceros.jpeg">
  <meta name="theme-color" content="#06222F">
  {% include "partials/schema.njk" %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {% set fontHref = "https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Hanken+Grotesk:wght@400;500;600;700&display=swap" %}
  <link rel="preload" as="style" href="{{ fontHref }}" onload="this.onload=null;this.rel='stylesheet'">
  <link rel="stylesheet" href="{{ fontHref }}" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="{{ fontHref }}"></noscript>
  <link rel="stylesheet" href="/assets/css/tokens.css">
  <link rel="stylesheet" href="/assets/css/base.css">
  <link rel="stylesheet" href="/assets/css/components.css">
</head>
<body>
  <a class="skip-link" href="#main">{{ t.skip }}</a>
  {% include "partials/header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  {% include "partials/sticky-cta.njk" %}
  {% include "partials/wa-float.njk" %}
  <script src="/assets/js/main.js" defer></script>
</body>
</html>
