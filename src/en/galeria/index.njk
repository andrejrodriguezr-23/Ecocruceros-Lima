  { f: "g3.jpg",  alt: "Three passengers smile in the water with the sea lion colony spread across the rocks behind them" },
  { f: "g4.jpg",  alt: "A couple swims in life vests in front of hundreds of sea lions on the rocks" },
  { f: "g5.jpg",  alt: "Two visitors pose in the water beside a rocky cave of the Palomino Islands" },
  { f: "g7.jpg",  alt: "A group of friends swims while one films the moment in front of the cliff" },
  { f: "g8.jpg",  alt: "Two young people smile in the water with the cliffs of the Palomino Islands behind them" },
  { f: "g9.jpg",  alt: "A couple laugh as they swim in life vests in front of the Palomino Islands sea lion colony" },
  { f: "g10.jpg", alt: "A passenger and a child swim with a life ring in front of the sea lion colony" },
  { f: "g11.jpg", alt: "A passenger calmly watches the sea lions from the water at the Palomino Islands" },
  { f: "g12.jpg", alt: "A visitor enjoys a relaxed swim in the Callao sea, beside the sea lions' rocks" },
