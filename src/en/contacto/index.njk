---
permalink: /en/contacto/
title: "Contact & booking"
description: "Book your Palomino Islands tour on WhatsApp (+51 986 671 093) or by email at informes@ecocruceros.com. Boarding point in La Punta, Callao, Peru."
---
{% set t = i18n[lang] %}
{% from "partials/icons.njk" import icon %}

<section class="section section--sky">
  <div class="container">
    <nav class="breadcrumbs" aria-label="breadcrumb"><a href="/en/">Home</a><span>›</span> Contact</nav>
    <p class="eyebrow" style="margin-top:var(--space-4)">Contact &amp; booking</p>
    <h1>Let's talk on WhatsApp</h1>
    <p class="lead">The fastest way to book and ask questions. {{ t.weReply }}.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="grid cols-2" style="align-items:start">
      <div class="card card--top"><div class="card__body stack">
        <span class="icon-chip">{{ icon("phone") }}</span>
        <h3>WhatsApp &amp; email</h3>
        <p style="font-size:1.25rem;font-weight:600;color:var(--text)">{{ site.whatsappDisplay }}</p>
        <p style="color:var(--text-secondary)">🕐 {{ t.hours }}.</p>
        <p>Email: <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
        <p>Social:
          <a href="{{ site.social.facebook }}" rel="noopener" target="_blank">Facebook</a> ·
          <a href="{{ site.social.instagram }}" rel="noopener" target="_blank">Instagram</a> ·
          <a href="{{ site.social.youtube }}" rel="noopener" target="_blank">YouTube</a>{% if site.social.tiktok %} ·
          <a href="{{ site.social.tiktok }}" rel="noopener" target="_blank">TikTok</a>{% endif %}
        </p>
      </div></div>
      <div class="card card--top-gold"><div class="card__body stack">
        <span class="icon-chip icon-chip--gold">{{ icon("anchor") }}</span>
        <h3>Boarding point</h3>
        <p><strong>{{ site.embarkation.name }}</strong> — {{ site.embarkation.role_en | lower }}.</p>
        <p>{{ site.embarkation.address }}. {{ site.embarkation.directions_en }}</p>
        <p><strong>Payment methods</strong> (always paid in advance):</p>
        <ul class="checklist">
          <li>Bank transfer or deposit (we share the account numbers when you book).</li>
        </ul>
      </div></div>
    </div>

    <div style="margin-top:var(--space-8)">
      <h2>{{ site.embarkation.name }} ({{ site.embarkation.role_en | lower }})</h2>
      <p style="margin-top:var(--space-2);color:var(--text-secondary)">{{ site.embarkation.address }}</p>
      <div class="embed embed--map" style="margin-top:var(--space-4)">
        <iframe src="{{ site.embarkation.mapsEmbed }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Map — Ecocruceros – La Punta (Boarding point)"></iframe>
      </div>
      <p class="embed-caption"><a href="{{ site.embarkation.mapsLink }}" rel="noopener" target="_blank">Open in Google Maps →</a></p>
    </div>
  </div>
</section>
